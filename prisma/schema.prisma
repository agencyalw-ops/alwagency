generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model portfolio {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  image       String
  link        String?
  createdAt   DateTime @default(now())
}

model admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
model testimoni {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  message   String
  image     String?
  rating    Int      @default(5)
  createdAt DateTime @default(now())
}