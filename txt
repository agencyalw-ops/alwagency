generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Portfolio {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  image       String
  link        String?
  createdAt   DateTime @default(now())
}

model admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
